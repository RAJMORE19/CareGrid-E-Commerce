pipeline {
    agent any

    environment {
        AWS_REGION       = 'ap-south-1'
        AWS_ACCOUNT_ID   = '466124992944'
        ECR_REPO_NAME    = 'caregrid/booking-service'
        SERVICE_DIR      = '02-microservices/booking-service'
        GIT_REPO_URL     = 'https://github.com/RAJMORE19/CareGrid-E-Commerce.git'
        GIT_BRANCH       = 'main'

        // Traceability: Build Number Tag
        IMAGE_TAG        = "${env.BUILD_NUMBER}"
        ECR_REGISTRY     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        FULL_IMAGE_NAME  = "${ECR_REGISTRY}/${ECR_REPO_NAME}"
        SONAR_HOST_URL   = "http://172.31.2.129:9000"
        
        // Smoke test variables
        TEST_CONTAINER   = "test-booking-service-${env.BUILD_NUMBER}"
        APP_TEST_PORT    = "8001"
    }

    stages {
        // ==========================================
        // 1. SOURCE CODE MANAGEMENT & UNIT TESTS
        // ==========================================
        stage('1. Checkout Source Code') {
            steps {
                cleanWs()
                git branch: "${env.GIT_BRANCH}", url: "${env.GIT_REPO_URL}"
            }
        }

        stage('2. Unit Tests') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh '''
                        echo "[INFO] Running Python Unit Tests..."
                        python3 -m unittest discover -s . -p "*test*.py" || echo "[WARN] No explicit test files found, proceeding."
                    '''
                }
            }
        }

        stage('3. Docker Build') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh """
                        echo "[INFO] Packaging container image..."
                        docker build -t ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG} .
                                            """
                }
            }
        }

        // ==========================================
        // 2. DEVSECOPS SECURITY SCANS
        // ==========================================
        stage('4. SonarQube Code Quality (SAST)') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh """
                            echo "[INFO] Running SonarQube Scanner against ${env.SONAR_HOST_URL}..."
                            docker run --rm \
                                --network host \
                                -v "\$(pwd):/usr/src" \
                                sonarsource/sonar-scanner-cli:latest \
                                -Dsonar.projectKey=caregrid-booking-service \
                                -Dsonar.projectName=caregrid-booking-service \
                                -Dsonar.sources=. \
                                -Dsonar.host.url=${env.SONAR_HOST_URL} \
                                -Dsonar.login=\${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('5. Dependency Vulnerability Scan (SCA)') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh '''
                        echo "[INFO] Scanning requirements.txt for CVEs via pip-audit..."
                        docker run --rm \
                            -v "$(pwd)":/app \
                            -w /app \
                            python:3.11-slim bash -c "
                                pip install --no-cache-dir pip-audit && \
                                pip-audit -r requirements.txt
                            "
                    '''
                }
            }
        }

        stage('6. Trivy Container Image Scan') {
            steps {
                sh """
                    echo "[INFO] Running vulnerability scan with Trivy..."
                    trivy image --severity HIGH,MEDIUM,LOW ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG} || true

                    echo "[INFO] Enforcing 0 CRITICAL CVE Gate..."
                    trivy image --exit-code 1 --severity CRITICAL ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG}
                """
            }
        }

        // ==========================================
        // 3. RUNTIME LOCAL CONTAINER VERIFICATION
        // ==========================================
        stage('7. Local Container Smoke Test') {
            steps {
                sh """
                    echo "[INFO] Spanning temporary test container to verify startup stability..."
                    docker run -d --name ${env.TEST_CONTAINER} -p ${env.APP_TEST_PORT}:5004 ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG}

                    sleep 5

                    docker ps | grep ${env.TEST_CONTAINER} || { echo "[ERROR] Container crashed on startup!"; exit 1; }

                    echo "[INFO] Testing HTTP responsiveness..."
                    curl --fail --silent --show-error --retry 5 --retry-connrefused http://localhost:${env.APP_TEST_PORT}/health
                """
            }
        }

        // ==========================================
        // 4. ECR REGISTRY PUBLISH
        // ==========================================
        stage('8. Push to AWS ECR') {
            steps {
                sh """
                    echo "[INFO] Authenticating with AWS ECR..."
                    aws ecr get-login-password --region ${env.AWS_REGION} | \
                      docker login --username AWS --password-stdin ${env.ECR_REGISTRY}

                    echo "[INFO] Pushing verified container artifacts..."
                    docker push ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG}
                """
            }
        }
    }

    post {
        always {
            sh """
                echo "[INFO] Cleanup: Removing local test container & runner images..."
                docker rm -f ${env.TEST_CONTAINER} || true
                docker rmi ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG} || true
                            """
        }
        success {
            echo "=========================================================================="
            echo " [STATUS: SUCCESS] Enterprise CI Finished Successfully."
            echo " SAST (SonarQube) + SCA (pip-audit) + Trivy Scan + Smoke Test PASSED."
            echo " Artifact pushed: ${env.FULL_IMAGE_NAME}:${env.IMAGE_TAG}"
            echo "=========================================================================="
        }
        failure {
            echo "=========================================================================="
            echo " [STATUS: FAILED] CI Pipeline failed. Check security or runtime logs."
            echo "=========================================================================="
        }
    }
}
